{
  "name": "pmoffice",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/check-public.mjs && node scripts/build-pms.mjs && node scripts/build-ebook-site.mjs && vitepress build docs && node scripts/check-public.mjs --dist",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "pms:build": "node scripts/build-pms.mjs",
    "pms:server": "node scripts/build-pms-server.mjs",
    "korail:test": "node --test tests/korail*.test.mjs tests/member*.test.mjs",
    "pms:test": "node --test tests/pms*.test.mjs",
    "ebook:build": "cd ebook-app && node build.mjs",
    "ebook:test": "cd ebook-app && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "0.8.2",
    "linkedom": "0.18.12",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "saxes": "6.0.0",
    "vue": "3.5.43"
  }
}
