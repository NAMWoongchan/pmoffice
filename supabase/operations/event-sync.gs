// Replace existing doPost in the authorized inquiry Apps Script with this handler. Run installEventSync once after deploying the same web-app URL. No credential changes.
function doPost(e){try{const body=JSON.parse(e.postData.contents),p=props_();if(body.signature!==sign_(body.message,p.BRIDGE_SECRET))throw Error('Invalid signature');const m=JSON.parse(body.message);if(m.action!=='wake'||Math.abs(Date.now()/1000-m.ts)>300||!m.nonce)throw Error('Expired');const cache=CacheService.getScriptCache(),key='wake:'+m.nonce;if(cache.get(key))return ContentService.createTextOutput('duplicate');cache.put(key,'1',300);if(m.scope==='software')syncSoftwareIssues();else processQueue();return ContentService.createTextOutput('ok');}catch(_){return ContentService.createTextOutput('not processed');}}

function installEventSync(){if(Session.getEffectiveUser().getEmail().toLowerCase()!=='namwoongchan@gmail.com')throw Error('지정 관리자 계정에서 실행해 주세요.');props_();ScriptApp.getProjectTriggers().filter(t=>['processQueue','syncSoftwareIssues'].includes(t.getHandlerFunction())&&t.getTriggerSource()===ScriptApp.TriggerSource.CLOCK).forEach(t=>ScriptApp.deleteTrigger(t));console.log('정기 연동 제거 완료. 서버 변경 알림 및 시트 직접 수정 이벤트만 사용합니다.');}
